diff --git a/widget/cocoa/nsWindowMap.mm b/widget/cocoa/nsWindowMap.mm
index 055b1b095e..54edcb0bcd 100644
--- a/widget/cocoa/nsWindowMap.mm
+++ b/widget/cocoa/nsWindowMap.mm
@@ -7,6 +7,10 @@
 #include "nsCocoaWindow.h"
 #include "nsObjCExceptions.h"
 
+// A Zen standalone window is an auxiliary NSPanel, so AppKit never makes it
+// main. Ask Zen whether this is that window before deciding it is inactive.
+extern bool ZenWindowActsAsMain(NSWindow* aWindow);
+
 @interface WindowDataMap (Private)
 
 - (NSString*)keyForWindow:(NSWindow*)inWindow;
@@ -236,7 +240,8 @@ - (void)windowBecameKey:(NSNotification*)inNotification {
   id delegate = window.delegate;
   if (!delegate || ![delegate isKindOfClass:[WindowDelegate class]]) {
     [TopLevelWindowData activateInWindowViews:window];
-  } else if (window.isSheet || window.isMainWindow) {
+  } else if (window.isSheet || window.isMainWindow ||
+             ZenWindowActsAsMain(window)) {
     [TopLevelWindowData activateInWindow:window];
   }
 }
@@ -247,7 +252,8 @@ - (void)windowResignedKey:(NSNotification*)inNotification {
   id delegate = window.delegate;
   if (!delegate || ![delegate isKindOfClass:[WindowDelegate class]]) {
     [TopLevelWindowData deactivateInWindowViews:window];
-  } else if (window.isSheet || window.isMainWindow) {
+  } else if (window.isSheet || window.isMainWindow ||
+             ZenWindowActsAsMain(window)) {
     [TopLevelWindowData deactivateInWindow:window];
   }
 }
